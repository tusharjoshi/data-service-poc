root = true

[*.{yml,yaml,md,markdown,txt}]
charset = utf-8
end_of_line = lf

[*.{java,gradle,groovy,properties,xml,kt}]
charset = utf-8
end_of_line = lf
indent_style = tab
indent_size = tab

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2

[*.*]
trim_trailing_whitespace = true
insert_final_newline = true
