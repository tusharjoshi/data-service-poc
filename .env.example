# Copy this file to `.env` and adjust values if needed.
# The application modules in this repository use JDBC URLs like
# jdbc:postgresql://localhost:5432/postgres so these defaults match those files.

POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# You can also change the external host port if 5432 is in use on your machine
# e.g. POSTGRES_HOST_PORT=15432 and then update the docker-compose ports mapping
POSTGRES_HOST_PORT=5432
